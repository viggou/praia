use "testing"

// Verify that C++ throw helpers on the engine side produce typed
// Error subclass instances with structured fields — the first module
// (fs.*) to migrate to praia::throwIOError / throwTypeError /
// throwValueError. See src/errors.h for the helper API and
// src/interpreter_setup.cpp for the fs.* migration.

// ── fs.read: missing file → IOError with path + errno ──────────
testing.test("fs.read on a missing file surfaces IOError", lam{ in
    try {
        fs.read("/no/such/file/xyz-PRAIA-TEST")
        testing.expect(false, "expected fs.read to throw")
    } catch (e) {
        testing.expect(e is IOError, "IOError")
        testing.expect(e is Error,   "IOError extends Error")
        testing.expectEqual(e.path, "/no/such/file/xyz-PRAIA-TEST",
                            ".path carries the offending path")
        testing.expect(e.errno != 0 && e.errno != nil,
                       ".errno is a real errno (ENOENT=2 on POSIX)")
        testing.expect(str(e).contains("Cannot read"),
                       "str(e) still readable")
    }
})

// ── fs.chmod: bad arg types → TypeError, not IOError ───────────
testing.test("fs.chmod with non-string path → TypeError", lam{ in
    try {
        fs.chmod(123, 0)
        testing.expect(false, "expected TypeError")
    } catch (e) {
        testing.expect(e is TypeError, "TypeError")
        testing.expect(!(e is IOError), "not IOError — arg-shape, not I/O")
    }
})

testing.test("fs.chmod with non-numeric mode → TypeError", lam{ in
    try {
        fs.chmod("/tmp", "not-a-number")
        testing.expect(false, "expected TypeError")
    } catch (e) {
        testing.expect(e is TypeError, nil)
    }
})

// ── fs.open: invalid mode string → ValueError ──────────────────
testing.test("fs.open with a bogus mode string → ValueError", lam{ in
    try {
        fs.open("/tmp/should-not-open", "bogus-mode")
        testing.expect(false, "expected ValueError")
    } catch (e) {
        testing.expect(e is ValueError, "ValueError — mode is right type, wrong value")
        testing.expect(!(e is IOError), "not IOError")
        testing.expect(str(e).contains("invalid mode"), nil)
    }
})

// ── fs.stat: missing path → IOError with path + errno ──────────
testing.test("fs.stat on a missing path → IOError w/ path + errno", lam{ in
    try {
        fs.stat("/no/such/xyz-PRAIA-TEST")
        testing.expect(false, "expected IOError")
    } catch (e) {
        testing.expect(e is IOError, nil)
        testing.expectEqual(e.path, "/no/such/xyz-PRAIA-TEST", nil)
        testing.expect(e.errno != 0 && e.errno != nil, nil)
    }
})

// ── FileHandle: read on closed handle → IOError w/ path ────────
testing.test("FileHandle after close → IOError carrying the path", lam{ in
    let tmp = fs.mktemp("praia-errhelpers")
    let h = fs.open(tmp, "r")
    h.close()
    try {
        h.read(4)
        testing.expect(false, "expected IOError")
    } catch (e) {
        testing.expect(e is IOError, nil)
        testing.expectEqual(e.path, tmp,
                            ".path pinned on the handle survives close()")
        testing.expect(str(e).contains("closed"), nil)
    }
    fs.remove(tmp)
})

// ── Regression: engine RuntimeError still coerces to base Error ─
//
// The migration is incremental. Every non-migrated `throw RuntimeError`
// (e.g. `1/0` inside the interpreter) must still land as a plain
// `Error` instance — otherwise the whole codebase would need to move
// in lockstep. This test pins that contract on the tree-walker path.
testing.test("bare RuntimeError still wraps to base Error", lam{ in
    try {
        let x = 1 / 0
    } catch (e) {
        testing.expect(e is Error,     "Error base still works")
        testing.expect(!(e is IOError), "no accidental subclass upgrade")
        testing.expect(!(e is TypeError), "no accidental subclass upgrade")
    }
})

// ── Regression: user throw of a raw value still flows verbatim ──
testing.test("user `throw \"raw\"` bypasses the coercion path", lam{ in
    try { throw "raw" } catch (e) {
        testing.expectEqual(e, "raw", "user-thrown string arrives verbatim")
    }
})

testing.done()
