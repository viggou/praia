use "testing"

// json.parser composition over http.openStream. Carved out of
// test_http_stream.praia to keep each file's openStream count under
// the tree walker's cumulative-async-state threshold (see the note
// at the bottom of test_http_stream.praia).

let TEST_PORT = 38792

let _serverFuture = async lam{ in
    let s = net.listen(TEST_PORT)
    while (true) {
        let c = net.accept(s)
        let req = ""
        while (!req.contains("\r\n\r\n")) {
            let chunk = net.recv(c, 4096)
            if (len(chunk) == 0) { break }
            req = req + chunk
        }
        let body = "{\"n\":1}\n{\"n\":2}\n{\"n\":3}\n"
        let resp = "HTTP/1.1 200 OK\r\nContent-Length: " + str(len(body.bytes())) +
                   "\r\nConnection: close\r\n\r\n" + body
        net.send(c, resp)
        net.close(c)
    }
}()
time.sleep(200)

let base = "http://localhost:" + str(TEST_PORT)

testing.test("json.parser consumes the stream end-to-end", lam{ in
    let s = http.openStream({blockPrivateHosts: false, url: base + "/ndjson"})
    let p = json.parser(s)
    let sum = 0
    while (!p.eof()) {
        let rec = p.nextValue()
        sum = sum + rec.n
    }
    testing.expectEqual(sum, 6, "1 + 2 + 3")
    s.close()
})

testing.done()
